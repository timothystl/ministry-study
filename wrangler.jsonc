{
  // The Worker name must match the existing Cloudflare project for study.timothystl.org.
  "name": "ministry-study",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // The database was created in the Cloudflare dashboard. The worker creates
  // its own tables on first use.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timothy-study-db",
      "database_id": "90b2cca9-a368-4185-8263-55f32d8dce1a",
    },
  ],
  // Identifiers of the Cloudflare Access application that protects study.timothystl.org.
  // Neither is a secret; the API refuses every request that does not carry a valid Access token.
  "vars": {
    "STUDY_ACCESS_TEAM_DOMAIN": "timothystl.cloudflareaccess.com",
    "STUDY_ACCESS_AUD": "a3a08cd0874810dfbbb02bb7a207db943b83631f8e40c95be952ae751817c362",
  },
}
