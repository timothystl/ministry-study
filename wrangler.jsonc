{
  // The Worker name must match the existing Cloudflare project for study.timothystl.org.
  "name": "ministry-study",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // The database was created in the Cloudflare dashboard. The worker creates
  // its own tables on first use.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timothy-study-db",
      "database_id": "90b2cca9-a368-4185-8263-55f32d8dce1a",
    },
  ],
  // Set in the Cloudflare dashboard (Settings → Variables): STUDY_ACCESS_TEAM_DOMAIN, STUDY_ACCESS_AUD,
  // and STUDY_ADMIN_EMAIL (the pastor's sign-in address; everyone else is added on the People page).
  // Workers Logs: a short record of requests and errors, for diagnosing problems. It is kept here so a
  // publish from this file cannot switch it back off. Never write catalog, sermon or note content to logs.
  "observability": {
    "enabled": true,
  },
}
